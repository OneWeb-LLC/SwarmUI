# Shared Supabase (One OS / OWeb constellation)
SUPABASE_PROJECT_ID=ebjzdcnphkfpxfldnatm
SUPABASE_URL=https://auth.oweb.one
NEXT_PUBLIC_SUPABASE_URL=https://auth.oweb.one
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OWeb control plane
NEXT_PUBLIC_OWEB_APP_URL=https://oweb.one
NEXT_PUBLIC_OWEB_PLATFORM_API_URL=https://oweb.one/api/v1

# This satellite (set in Vercel production + preview)
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# OWeb ecosystem app id (register in oweb ecosystem-apps.ts before App Store launch)
NEXT_PUBLIC_OWEB_APP_ID=swarmui

# Enforce OneID on /studio (default: true in production)
NEXT_PUBLIC_SWARMUI_REQUIRE_AUTH=true

# GPU / Docker SwarmUI engine (RunPod, Vast, self-hosted) — not hosted on Vercel
NEXT_PUBLIC_SWARMUI_BACKEND_URL=
